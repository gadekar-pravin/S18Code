# run_local.py needs none of this: it talks to Ollama on localhost.

# Only needed for run_benchmark.py, the hosted-model variant.
GEMINI_API_KEYS=key1,key2,key3

# Only needed for run_assignment.py, the assignment grid on OpenRouter.
# A single key. Never commit the real one: .env and .env.* are gitignored.
OPENROUTER_API_KEY=sk-or-v1-...
